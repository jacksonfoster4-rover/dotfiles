# Laptop-local zsh config, git-tracked in dotfiles. Sourced from ~/.zshrc.
# Holds machine-specific aliases and helpers that don't belong in the shared,
# cross-machine .sharedrc.append.

# brew shellenv runs in ~/.zprofile (login shells) — no need to repeat here
alias local_setup="~/projects/web/dev-env/local-setup/dist/local-setup.sh"
alias reload_nvim="rm -rf ~/.local/share/nvim && rm -rf ~/.config/nvim/ && cp -r ~/projects/dotfiles/nvim ~/.config"
alias staging="k9s --context staging-a"

function killport() { lsof -i TCP:$1 | grep LISTEN | awk '{print $2}' | xargs kill -9; }

# Pick a running Coder workspace and echo its name. Auto-selects when only one
# is running; uses fzf if present, else a numbered menu.
pick_coder_workspace() {
  local -a names
  names=("${(@f)$(coder list -o json 2>/dev/null |
    jq -r '.[] | select(.latest_build.status == "running") | .name')}")
  names=(${names:#})  # drop empty entries from the command substitution
  if (( ${#names} == 0 )); then
    echo "No running Coder workspaces" >&2
    return 1
  fi
  if (( ${#names} == 1 )); then
    echo "${names[1]}"
    return 0
  fi
  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${names[@]}" | fzf --prompt='workspace> '
  else
    # `select` writes its menu/prompt to stderr, so only the chosen name (echoed
    # to stdout) is captured by the caller's command substitution.
    local ws
    select ws in "${names[@]}"; do
      [[ -n "$ws" ]] && { echo "$ws"; break; }
    done
  fi
}

# Copy ~/.ssh/id_rsa and id_rsa.pub into a Coder workspace's devcontainer, so
# git over SSH works there. `upload_ssh [workspace]`; with no argument it asks
# which running workspace. The keys travel base64-encoded inside the remote
# command rather than over stdin, because `coder ssh` allocates a terminal even
# for piped input and that mangles binary-safe transfers.
upload_ssh() {
  local ws=${1:-$(pick_coder_workspace)} || return 1
  [[ -z "$ws" ]] && { echo "No workspace selected" >&2; return 1; }
  local key pub
  key=$(base64 < ~/.ssh/id_rsa | tr -d '\n') || return 1
  pub=$(base64 < ~/.ssh/id_rsa.pub | tr -d '\n') || return 1
  coder ssh "$ws.dev" -- "mkdir -p ~/.ssh && chmod 700 ~/.ssh \
    && echo $key | base64 -d > ~/.ssh/id_rsa && chmod 600 ~/.ssh/id_rsa \
    && echo $pub | base64 -d > ~/.ssh/id_rsa.pub && chmod 644 ~/.ssh/id_rsa.pub" &&
    echo "Copied SSH keys to $ws"
}
