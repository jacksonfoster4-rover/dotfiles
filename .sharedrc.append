# Resolve the dotfiles checkout from wherever THIS file is sourced, so it works
# on any box (Codespaces, Coder, local) rather than a hardcoded Codespaces path.
# This file lives at the repo root, so dirname of its own path IS that root, and
# reload_dotfiles uses $DOTFILES_PATH as the repo root. The sourced-file path is
# $BASH_SOURCE in bash; zsh's ${(%):-%x} prompt-expansion is the equivalent (the
# bash branch never runs that zsh-only syntax, so bash won't choke on it).
if [ -n "${ZSH_VERSION:-}" ]; then
  _dotfiles_src="${(%):-%x}"
else
  _dotfiles_src="${BASH_SOURCE[0]}"
fi
export DOTFILES_PATH="$(cd "$(dirname "$_dotfiles_src")" >/dev/null 2>&1 && pwd)"
unset _dotfiles_src
alias start_rxn="(cd src/frontend/reactNativeApp && pnpm start)"
alias preload_rxn="curl -o /dev/null 'http://localhost:8081/index.bundle?platform=ios&dev=true&lazy=true&minify=false&inlineSourceMap=false&modulesOnly=false&runModule=true&excludeSource=true&sourcePaths=url-server&app=com.rover.Rover-com' \
-H 'Host: localhost:8081' \
-H 'Connection: keep-alive' \
-H 'Accept: multipart/mixed' \
-H 'User-Agent: Rover.com/3 CFNetwork/1474 Darwin/25.3.0' \
-H 'Accept-Language: en-US,en;q=0.9'"
alias makeschemas="m generate_api_schemas && (cd src/frontend/rsdk && pnpm run build:apiClient)"
alias followlogs="dc logs -f -n 20"
alias fetchandreset="git fetch && git reset --hard origin/master"
alias restartcontainers="dc down && dc up -d"
alias msp="m shell_plus"
# Pull the latest dotfiles and re-run the installer (updates nvim config +
# plugins). Runs install.sh from the repo root since it relies on $(pwd).
#   reload_dotfiles             pull; stops if the checkout has local changes
#   reload_dotfiles -f|--force  discard unstaged changes first, then pull
reload_dotfiles() {
  # With -f/--force, throw away any local modifications to tracked files in the
  # dotfiles checkout so the ff-only pull below can't be blocked by "your local
  # changes would be overwritten by merge". Handy on a box where something
  # edited the dotfiles in place; without it, reload_dotfiles stops and leaves
  # you to resolve by hand. Only touches tracked files — untracked ones stay.
  local force=""
  [[ "$1" == "-f" || "$1" == "--force" ]] && force=1
  [[ -n "$force" ]] && { git -C "$DOTFILES_PATH" reset --hard HEAD || return; }
  # +Lazy! sync updates plugins; +TSUpdateSync recompiles every treesitter
  # parser against the running nvim's ABI. The Sync variant blocks (plain
  # +TSUpdate is async and would lose the race against install.sh's +qa),
  # so parsers never go stale after a nvim upgrade — a stale parser is what
  # throws "attempt to call method 'range' (a nil value)" in the highlighter.
  git -C "$DOTFILES_PATH" pull --ff-only &&
    (cd "$DOTFILES_PATH" && ./install.sh "+Lazy! sync" "+TSUpdateSync") || return
  # Reload the current shell's rc so new aliases/functions are picked up now.
  if [ -n "$ZSH_VERSION" ]; then
    source ~/.zshrc
  elif [ -n "$BASH_VERSION" ]; then
    source ~/.bashrc
  fi
}
alias staging="k9s --context staging-a"

# review — open the current branch's diff vs master in difit, a GitHub-like diff
# viewer with inline comments. Serves headless on a fixed port (4966), bound to
# 0.0.0.0 so Coder Connect can reach it, and prints the URL to open from the
# laptop. Over Coder Connect the workspace is one host with the port in the
# authority (URI_AUTHORITY is <host>:8001), so we swap in difit's port; off a
# Roverspace box it falls back to localhost. Fetches the base first, then diffs
# from the merge-base (true branch-vs-master, like a PR) to HEAD. Ctrl-C stops it.
#   review                 # vs origin/master
#   review origin/release  # vs another base ref
review() {
  local base="${1:-origin/master}"
  if ! command -v difit >/dev/null 2>&1; then
    echo "difit not installed — run reload_dotfiles (or: npm i -g difit)" >&2
    return 1
  fi
  # Best-effort refresh of the base; strip any remote/ prefix for the fetch.
  git fetch --quiet origin "${base##*/}" 2>/dev/null || true
  local host
  if [ -n "${URI_AUTHORITY:-}" ]; then
    host="${URI_AUTHORITY%:*}"
  elif [ -n "${CODER_WORKSPACE_NAME:-}" ]; then
    host="${CODER_WORKSPACE_AGENT_NAME}.${CODER_WORKSPACE_NAME}.${CODER_WORKSPACE_OWNER_NAME}.coder"
  else
    host="localhost"
  fi
  echo "difit → http://${host}:4966  (Ctrl-C to stop)"
  difit "$base" --merge-base --no-open --keep-alive --host 0.0.0.0 --port 4966
}
